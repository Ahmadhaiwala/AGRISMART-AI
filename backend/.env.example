# Application Settings
APP_NAME=Agrismart AI
APP_VERSION=1.0.0
API_PREFIX=/api/v1
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# Model Settings
MODEL_PATH=models/plant_disease_efficientnet_b0_38class_best.pth
HF_MODEL_REPO=Ahmadhaiwala/agro_model
HF_MODEL_FILE=plant_disease_efficientnet_b0_38class_best.pth
CUDA_AVAILABLE=false

# Image Processing
IMAGE_SIZE=224
MAX_IMAGE_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png

# CORS Settings (comma-separated for multiple origins)
CORS_ORIGINS=*
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# LLM Settings (OpenRouter for Farmer Assistant and Agentic Advisor)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2-7b-instruct:free
